          "section": "entire file"
        },
        {
          "file": "web/www/horas/Latin/Psalterium/Common/Prayers.txt",
          "section": "Gloria"
        }
      ],
      "source": "https://github.com/DivinumOfficium/divinum-officium/blob/08edec53cc13f9bd109d2ebcae93529b504003bd/web/www/horas/Latin/Psalterium/Psalmi/Psalmi minor.txt",
