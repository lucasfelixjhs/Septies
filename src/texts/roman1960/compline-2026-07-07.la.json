    {
      "id": "roman1960-2026-07-07-psalm-15",
      "kind": "psalm",
      "title": "Salmo 15 · Repetición de la antífona",
      "latinLines": [
        [
          {
            "text": "Psalmus 15",
            "rubric": true
          },
          {
            "text": " [3]",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:1",
            "rubric": true
          },
          {
            "text": " Consérva me, Dómine, quóniam sperávi in te. † Dixi Dómino: Deus meus es tu, * quóniam bonórum meórum non eges.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:3",
            "rubric": true
          },
          {
            "text": " Sanctis, qui sunt in terra eius, * mirificávit omnes voluntátes meas in eis.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:4",
            "rubric": true
          },
          {
            "text": " Multiplicátæ sunt infirmitátes eórum: * póstea acceleravérunt.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:4",
            "rubric": true
          },
          {
            "text": " Non congregábo conventícula eórum de sanguínibus, * nec memor ero nóminum eórum per lábia mea.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:5",
            "rubric": true
          },
          {
            "text": " Dóminus pars hereditátis meæ, et cálicis mei: * tu es, qui restítues hereditátem meam mihi.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:6",
            "rubric": true
          },
          {
            "text": " Funes cecidérunt mihi in præcláris: * étenim heréditas mea præclára est mihi.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:7",
            "rubric": true
          },
          {
            "text": " Benedícam Dóminum, qui tríbuit mihi intelléctum: * ínsuper et usque ad noctem increpuérunt me renes mei.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:8",
            "rubric": true
          },
          {
            "text": " Providébam Dóminum in conspéctu meo semper: * quóniam a dextris est mihi, ne commóvear.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:9",
            "rubric": true
          },
          {
            "text": " Propter hoc lætátum est cor meum, et exsultávit lingua mea: * ínsuper et caro mea requiéscet in spe.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:10",
            "rubric": true
          },
          {
            "text": " Quóniam non derelínques ánimam meam in inférno: * nec dabis sanctum tuum vidére corruptiónem.",
            "rubric": false
          }
        ],
        [
          {
            "text": "15:11",
            "rubric": true
          },
          {
            "text": " Notas mihi fecísti vias vitæ, † adimplébis me lætítia cum vultu tuo: * delectatiónes in déxtera tua usque in finem.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℣.",
            "rubric": true
          },
          {
            "text": " Glória Patri, et Fílio, * et Spirítui Sancto.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℟.",
            "rubric": true
          },
          {
            "text": " Sicut erat in princípio, et nunc, et semper, * et in sǽcula sæculórum. Amen.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Ant.",
            "rubric": true
          },
          {
            "text": " Tu, Dómine, servábis nos: et custódies nos in ætérnum.",
            "rubric": false
          }
        ]
      ],
