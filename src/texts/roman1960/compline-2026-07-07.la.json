    },
    {
      "id": "roman1960-2026-07-07-examination",
      "kind": "prayer",
      "title": "Examen y confesión",
      "latinLines": [
        [
          {
            "text": "℣.",
            "rubric": true
          },
          {
            "text": " Adiutórium nostrum ",
            "rubric": false
          },
          {
            "text": "✠",
            "rubric": true
          },
          {
            "text": " in nómine Dómini.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℟.",
            "rubric": true
          },
          {
            "text": " Qui fecit cælum et terram.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Examen conscientiæ vel Pater Noster totum secreto.",
            "rubric": true
          }
        ],
        [
          {
            "text": "Pater noster, qui es in cælis, sanctificétur nomen tuum: advéniat regnum tuum: fiat volúntas tua, sicut in cælo et in terra. Panem nostrum cotidiánum da nobis hódie: et dimítte nobis débita nostra, sicut et nos dimíttimus debitóribus nostris: et ne nos indúcas in tentatiónem: sed líbera nos a malo. Amen.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Confíteor Deo omnipoténti, beátæ Maríæ semper Vírgini, beáto Michaéli Archángelo, beáto Ioánni Baptístæ, sanctis Apóstolis Petro et Paulo, et ómnibus Sanctis, quia peccávi nimis, cogitatióne, verbo et ópere: ",
            "rubric": false
          },
          {
            "text": "(percutit sibi pectus)",
            "rubric": true
          },
          {
            "text": " mea culpa, mea culpa, mea máxima culpa. Ídeo precor beátam Maríam semper Vírginem, beátum Michaélem Archángelum, beátum Ioánnem Baptístam, sanctos Apóstolos Petrum et Paulum, et omnes Sanctos, oráre pro me ad Dóminum Deum nostrum.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Misereátur nostri omnípotens Deus, et dimíssis peccátis nostris, perdúcat nos ad vitam ætérnam. Amen.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Indulgéntiam, ",
            "rubric": false
          },
          {
            "text": "✠",
            "rubric": true
          },
          {
            "text": " absolutiónem et remissiónem peccatórum nostrórum tríbuat nobis omnípotens et miséricors Dóminus. Amen.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℣.",
            "rubric": true
          },
          {
            "text": " Convérte nos ",
            "rubric": false
          },
          {
            "text": "✙︎",
            "rubric": true
          },
          {
            "text": " Deus, salutáris noster.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℟.",
            "rubric": true
          },
          {
            "text": " Et avérte iram tuam a nobis.",
            "rubric": false
          }
        ]
      ],
      "sourceCell": "Completorium3",
      "sourceRefs": [
        {
          "file": "web/www/horas/Latin/Psalterium/Common/Prayers.txt",
          "section": "Adjutorium nostrum; rubrica examen; Pater noster; Confiteor; Misereatur; Indulgentiam; Converte nos"
        }
      ],
      "source": "https://github.com/DivinumOfficium/divinum-officium/blob/08edec53cc13f9bd109d2ebcae93529b504003bd/web/www/horas/Latin/Psalterium/Common/Prayers.txt",
      "rights": "Datos MIT · textos latinos tradicionales; véase el informe de fuentes.",
      "verified": true
    },
    {
      "id": "roman1960-2026-07-07-opening",
      "kind": "prayer",
      "title": "Invocación inicial",
      "latinLines": [
        [
          {
            "text": "℣.",
            "rubric": true
          },
          {
            "text": " Deus ",
            "rubric": false
          },
          {
            "text": "✠",
            "rubric": true
          },
          {
            "text": " in adiutórium meum inténde.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℟.",
            "rubric": true
          },
          {
            "text": " Dómine, ad adiuvándum me festína.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Glória Patri, et Fílio, * et Spirítui Sancto.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Sicut erat in princípio, et nunc, et semper, * et in sǽcula sæculórum. Amen.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Allelúia.",
            "rubric": false
          }
        ]
      ],
      "sourceCell": "Completorium4",
      "sourceRefs": [
        {
          "file": "web/www/horas/Latin/Psalterium/Common/Prayers.txt",
          "section": "Deus in adjutorium; Gloria; Alleluia"
        }
      ],
      "source": "https://github.com/DivinumOfficium/divinum-officium/blob/08edec53cc13f9bd109d2ebcae93529b504003bd/web/www/horas/Latin/Psalterium/Common/Prayers.txt",
      "rights": "Datos MIT · textos latinos tradicionales; véase el informe de fuentes.",
      "verified": true
    },
    {
      "id": "roman1960-2026-07-07-psalm-11",
      "kind": "psalm",
      "title": "Salmo 11 · Antífona inicial",
      "latinLines": [
        [
          {
            "text": "Ant.",
            "rubric": true
          },
          {
            "text": " Tu, Dómine, * servábis nos: et custódies nos in ætérnum.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Psalmus 11",
            "rubric": true
          },
          {
            "text": " [1]",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:2",
            "rubric": true
          },
          {
            "text": " Salvum me fac, Dómine, quóniam defécit sanctus: * quóniam diminútæ sunt veritátes a fíliis hóminum.",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:3",
            "rubric": true
          },
          {
            "text": " Vana locúti sunt unusquísque ad próximum suum: * lábia dolósa, in corde et corde locúti sunt.",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:4",
            "rubric": true
          },
          {
            "text": " Dispérdat Dóminus univérsa lábia dolósa, * et linguam magníloquam.",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:5",
            "rubric": true
          },
          {
            "text": " Qui dixérunt: Linguam nostram magnificábimus, † lábia nostra a nobis sunt, * quis noster Dóminus est?",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:6",
            "rubric": true
          },
          {
            "text": " Propter misériam ínopum, et gémitum páuperum, * nunc exsúrgam, dicit Dóminus.",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:6",
            "rubric": true
          },
          {
            "text": " Ponam in salutári: * fiduciáliter agam in eo.",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:7",
            "rubric": true
          },
          {
            "text": " Elóquia Dómini, elóquia casta: * argéntum igne examinátum, probátum terræ purgátum séptuplum.",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:8",
            "rubric": true
          },
          {
            "text": " Tu, Dómine, servábis nos: et custódies nos * a generatióne hac in ætérnum.",
            "rubric": false
          }
        ],
        [
          {
            "text": "11:9",
            "rubric": true
          },
          {
            "text": " In circúitu ímpii ámbulant: * secúndum altitúdinem tuam multiplicásti fílios hóminum.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℣.",
            "rubric": true
          },
          {
            "text": " Glória Patri, et Fílio, * et Spirítui Sancto.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℟.",
            "rubric": true
          },
          {
            "text": " Sicut erat in princípio, et nunc, et semper, * et in sǽcula sæculórum. Amen.",
            "rubric": false
          }
        ]
      ],
      "sourceCell": "Completorium5",
      "sourceRefs": [
        {
          "file": "web/www/horas/Latin/Psalterium/Psalmi/Psalmi minor.txt",
          "section": "Completorium / Feria III"
        },
        {
