      "verified": true
    },
    {
      "id": "roman1960-2026-07-07-psalm-12",
      "kind": "psalm",
      "title": "Salmo 12",
      "latinLines": [
        [
          {
            "text": "Psalmus 12",
            "rubric": true
          },
          {
            "text": " [2]",
            "rubric": false
          }
        ],
        [
          {
            "text": "12:1",
            "rubric": true
          },
          {
            "text": " Úsquequo, Dómine, obliviscéris me in finem? * Úsquequo avértis fáciem tuam a me?",
            "rubric": false
          }
        ],
        [
          {
            "text": "12:2",
            "rubric": true
          },
          {
            "text": " Quámdiu ponam consília in ánima mea, * dolórem in corde meo per diem?",
            "rubric": false
          }
        ],
        [
          {
            "text": "12:3",
            "rubric": true
          },
          {
            "text": " Úsquequo exaltábitur inimícus meus super me? * réspice, et exáudi me, Dómine, Deus meus.",
            "rubric": false
          }
        ],
        [
          {
            "text": "12:4",
            "rubric": true
          },
          {
            "text": " Illúmina óculos meos ne umquam obdórmiam in morte: * nequándo dicat inimícus meus: Præválui advérsus eum.",
            "rubric": false
          }
        ],
        [
          {
            "text": "12:5",
            "rubric": true
          },
          {
            "text": " Qui tríbulant me, exsultábunt si motus fúero: * ego autem in misericórdia tua sperávi.",
            "rubric": false
          }
        ],
        [
          {
            "text": "12:6",
            "rubric": true
          },
          {
            "text": " Exsultábit cor meum in salutári tuo: † cantábo Dómino qui bona tríbuit mihi: * et psallam nómini Dómini altíssimi.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℣.",
            "rubric": true
          },
          {
            "text": " Glória Patri, et Fílio, * et Spirítui Sancto.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℟.",
            "rubric": true
          },
          {
            "text": " Sicut erat in princípio, et nunc, et semper, * et in sǽcula sæculórum. Amen.",
            "rubric": false
          }
        ]
      ],
      "sourceCell": "Completorium6",
