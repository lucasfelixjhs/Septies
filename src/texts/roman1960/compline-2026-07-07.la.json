    {
      "id": "roman1960-2026-07-07-short-reading",
      "kind": "reading",
      "title": "Lectura breve",
      "latinLines": [
        [
          {
            "text": "1 Pet 5:8-9",
            "rubric": true
          }
        ],
        [
          {
            "text": "Fratres: Sóbrii estóte, et vigiláte: quia adversárius vester diábolus tamquam leo rúgiens círcuit, quærens quem dévoret: cui resístite fortes in fide.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℣.",
            "rubric": true
          },
          {
            "text": " Tu autem, Dómine, miserére nobis.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℟.",
            "rubric": true
          },
          {
            "text": " Deo grátias.",
            "rubric": false
          }
        ]
      ],
      "sourceCell": "Completorium2",
      "sourceRefs": [
