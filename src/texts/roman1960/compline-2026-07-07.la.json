          {
            "text": "℣.",
            "rubric": true
          },
          {
            "text": " Iube, Dómine, benedícere.",
            "rubric": false
          }
        ],
        [
          {
            "text": "Benedictio.",
            "rubric": true
          },
          {
            "text": " Noctem quiétam et finem perféctum concédat nobis Dóminus omnípotens.",
            "rubric": false
          }
        ],
        [
          {
            "text": "℟.",
            "rubric": true
          },
          {
            "text": " Amen.",
            "rubric": false
          }
        ]
      ],
